<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">1000</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="DD10151C">white.png</texture>
        </control>

        <control type="image">
            <left>60</left>
            <top>50</top>
            <width>1800</width>
            <height>980</height>
