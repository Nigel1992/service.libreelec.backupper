        </control>

        <control type="label">
            <left>100</left>
            <top>965</top>
            <width>1720</width>
            <height>30</height>
            <font>font12</font>
            <textcolor>FFB0BEC5</textcolor>
            <label>Press Enter to select backup, Esc/Back to cancel</label>
        </control>
