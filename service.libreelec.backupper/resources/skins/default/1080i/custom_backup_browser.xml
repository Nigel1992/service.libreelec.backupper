            <itemlayout height="72" width="880">
                <control type="label">
                    <left>14</left>
                    <top>8</top>
                    <width>850</width>
                    <height>30</height>
                    <font>font13</font>
                    <textcolor>FFE3EEF7</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>14</left>
                    <top>40</top>
                    <width>850</width>
                    <height>24</height>
                    <font>font12</font>
                    <textcolor>FF9CB5C8</textcolor>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
            </itemlayout>
            <focusedlayout height="72" width="880">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>880</width>
                    <height>72</height>
                    <texture colordiffuse="FF2E4C63">white.png</texture>
                </control>
                <control type="label">
                    <left>14</left>
                    <top>8</top>
                    <width>850</width>
                    <height>30</height>
                    <font>font13</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>14</left>
                    <top>40</top>
                    <width>850</width>
                    <height>24</height>
                    <font>font12</font>
                    <textcolor>FFC6DBEA</textcolor>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
            </focusedlayout>
        </control>

        <control type="scrollbar" id="1010">
            <left>1008</left>
            <top>190</top>
            <width>18</width>
            <height>760</height>
            <orientation>vertical</orientation>
        </control>

        <control type="image">
            <left>1060</left>
            <top>190</top>
            <width>760</width>
            <height>760</height>
            <texture colordiffuse="88142634">white.png</texture>
        </control>

